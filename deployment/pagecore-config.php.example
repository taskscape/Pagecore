<?php
/**
 * Copy this entire `pagecore-private` directory beside, never inside, the
 * public document root. Set PAGECORE_CONFIG to this file's absolute path.
 */
$privateRoot = __DIR__;
// Web requests take the public root from the server. Setting even one
// environment variable is awkward on shared hosting, so PAGECORE_DOCUMENT_ROOT
// is only needed where DOCUMENT_ROOT is absent — CLI tooling such as
// scripts/reindex.php.
$publicRoot = getenv('PAGECORE_DOCUMENT_ROOT');
if (!$publicRoot && !empty($_SERVER['DOCUMENT_ROOT'])) { $publicRoot = $_SERVER['DOCUMENT_ROOT']; }
if (!$publicRoot) { throw new RuntimeException('Set PAGECORE_DOCUMENT_ROOT, or run behind a server that provides DOCUMENT_ROOT.'); }
$publicRoot = rtrim(str_replace('\\', '/', $publicRoot), '/');

return array(
    'development_only' => false,
    'demo_credentials' => false,
    'session_name' => 'PAGECORE',
    'session_hours' => 8,
    'require_https' => true,
    'cookie_secure' => true,
    'hsts' => true,
    'hsts_max_age' => 31536000,
    'hsts_include_subdomains' => false,
    'trusted_proxies' => array(), // exact IPs or CIDRs; forwarded headers are ignored otherwise
    'username' => 'admin',
    'password_hash' => 'REPLACE_WITH_PASSWORD_HASH',
    'login_rate_limit_dir' => $privateRoot . '/state',
    'login_rate_window_seconds' => 300,
    'login_rate_source_limit' => 5,
    'login_rate_account_limit' => 10,
    'audit_enabled' => true,
    'audit_log_path' => $privateRoot . '/state/audit.jsonl',
    'audit_hash_key' => 'REPLACE_WITH_RANDOM_AUDIT_HASH_KEY',
    'audit_max_bytes' => 5242880,
    'content_dir' => $privateRoot . '/content',
    'backup_dir' => $privateRoot . '/backups',
    'backup_keep' => 20,
    'uploads_dir' => $privateRoot . '/uploads',
    // Leave empty for a fresh site: media is delivered by cms/media-file.php.
    // Content migrated from another CMS usually carries literal /uploads/...
    // URLs; keep '/uploads' and map the path to the media endpoint in the
    // fronting server rather than rewriting the content. For Apache:
    //   RewriteRule ^uploads/(.+)$ cms/media-file.php?path=$1 [L,QSA]
    'uploads_url' => '',
    'site_root' => $publicRoot,
    'site_url' => 'https://example.com',
    'site_name' => 'Example site',
    'max_upload_mb' => 8,
    'max_request_bytes' => 8912896,
    'max_content_bytes' => 1048576,
    'max_nav_bytes' => 65536,
    'max_metadata_bytes' => 4096,
    'max_title_bytes' => 255,
    'max_identifier_bytes' => 512,
    'max_query_bytes' => 256,
    'max_image_width' => 8000,
    'max_image_height' => 8000,
    'max_image_pixels' => 40000000,
    'max_upload_storage_bytes' => 268435456,
    'max_upload_files' => 2000,
    'max_uploads_per_month' => 200,
    'media_page_size' => 24,
    'max_media_page_size' => 50,
    'max_inventory_page_size' => 100,
    'max_inventory_items' => 5000,
    'max_search_query_bytes' => 100,
    'max_search_index_bytes' => 5242880,
    'max_search_index_items' => 5000,
    'max_search_results' => 100,
    'search_results_per_page' => 10,
    'allowed_ext' => array('jpg', 'jpeg', 'png', 'gif', 'webp', 'pdf'),
    'post_url' => '/post/{slug}/',
    'categories' => array(),
    'search_pages' => array(),
);
