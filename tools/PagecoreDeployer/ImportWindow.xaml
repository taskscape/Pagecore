<Window x:Class="PagecoreDeployer.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from Open Salamander" Height="360" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Choose a saved FTP bookmark. Its user name and password are copied into this app and stored encrypted with your Windows account. The password is not displayed here or written to the log."/>

        <ListBox Grid.Row="1" x:Name="BookmarkList" MouseDoubleClick="OnAccept">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#666" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" x:Name="HintText" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="#8A5A00"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Import" MinWidth="90" IsDefault="True" Click="OnAccept" Margin="0,0,8,0"/>
            <Button Content="Cancel" MinWidth="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
